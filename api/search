":3,"590":3,"591":3,"592":3,"593":2,"594":3,"595":3,"596":3,"597":3,"598":3,"599":3,"600":3,"601":3,"602":3,"603":3,"604":3,"605":3,"606":3,"607":3,"608":3,"609":3,"610":2,"611":3,"612":3,"613":3,"614":3,"615":3,"616":3,"617":3,"618":3,"619":3,"620":3,"621":3,"622":3,"623":3,"624":3,"625":3,"626":3,"627":3,"628":3,"629":3,"630":3,"631":3,"632":3,"633":3,"634":3,"635":3,"636":3,"637":3,"638":3,"639":3,"640":3,"641":2,"642":3,"643":3,"644":3,"645":3,"646":3,"647":3,"648":3,"649":2,"650":3,"651":3,"652":3,"653":3,"654":3,"655":3,"656":3,"657":3,"658":3,"659":3,"660":3,"661":3,"662":3}},"unstoredValues":{},"unstoredTerms":{}},"docs":{"docs":{"1":{"id":"/docs/architecture","page_id":"/docs/architecture","type":"page","content":"Architecture","breadcrumbs":["Documentation","How it works"],"tags":[],"url":"/docs/architecture"},"2":{"id":"/docs/architecture#0","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#the-layers-in-dependency-order","content":"The layers, in dependency order"},"3":{"id":"/docs/architecture#1","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#1-emulator","content":"1. Emulator"},"4":{"id":"/docs/architecture#2","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#2-root--rootavd--magisk","content":"2. Root — rootAVD + Magisk"},"5":{"id":"/docs/architecture#3","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#3-zygisk-modules","content":"3. Zygisk modules"},"6":{"id":"/docs/architecture#4","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#4-interception","content":"4. Interception"},"7":{"id":"/docs/architecture#5","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#5-host-tooling","content":"5. Host tooling"},"8":{"id":"/docs/architecture#6","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#what-fails-if-you-remove-a-layer","content":"What fails if you remove a layer"},"9":{"id":"/docs/architecture#7","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#design-decisions-worth-knowing","content":"Design decisions worth knowing"},"10":{"id":"/docs/architecture#8","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture","content":"Five layers, each one only there because without it a specific thing fails. The diagram is the fast way to understand the rig; the table below is the \"why\"."},"11":{"id":"/docs/architecture#9","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture","content":"<Mermaid chart=\"flowchart TB subgraph host[&quot;Host (Linux Mint)&quot;] M[mitmdump :18080<br/>mitm/dump.py] T[adb reverse tc…\" />"},"12":{"id":"/docs/architecture#10","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-emulator","content":"`pentest16` is a **Play Store** (`google_apis_playstore`) system image for API 36, x86_64, pixel_7 profile, 6 GB RAM, 16 GB data partition. Play Store matters: several attestation-ish code paths check for GMS presence and behave differently without it."},"13":{"id":"/docs/architecture#11","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-emulator","content":"It runs with KVM acceleration (`/dev/kvm`, user in `kvm` group), 4 vCPUs, and GPU on. Boot from cold is ~90 s; from a snapshot, ~25 s."},"14":{"id":"/docs/architecture#12","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-root--rootavd--magisk","content":"`rootAVD` patches `ramdisk.img` of the **system image** (not the AVD) with Magisk, then the Magisk app does a second \"additional setup\" pass on first boot. Result: `su` works, `context=u:r:magisk:s0`."},"15":{"id":"/docs/architecture#13","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-root--rootavd--magisk","content":"Magisk 31.1 specifics that bite:"},"16":{"id":"/docs/architecture#14","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-root--rootavd--magisk","content":"Built-in Zygisk must be **off** (`magisk --sqlite \"replace into settings (key,value) values('zygisk',0)\"`) because **Zygisk Next** owns injection."},"17":{"id":"/docs/architecture#15","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-root--rootavd--magisk","content":"Magisk's denylist is **empty** by design here. Adding an app would strip our modules (TrickyStore, PIF) from exactly the app that needs them."},"18":{"id":"/docs/architecture#16","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-root--rootavd--magisk","content":"`magisk --denylist rm <pkg> <process>` (two args) **segfaults the daemon**. Use one argument."},"19":{"id":"/docs/architecture#17","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-zygisk-modules","content":"| Module            | id         | Job                                                                    |\n| ----------------- | ---------- | ---------------------------------------------------------------------- |\n| Zygisk Next 1.5.3 | `zygisksu` | The injector. `zygiskd` CLI controls policy, memory type, module list. |","table":"table-0"},"20":{"id":"/docs/architecture#18","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-zygisk-modules","content":"| Module            | id             | Job                                                                                                    |\n| ----------------- | -------------- | ------------------------------------------------------------------------------------------------------ |\n| TrickyStore 1.4.1 | `tricky_store` | Replaces the keystore's attestation certificate chain for packages in `target.txt` using `keybox.xml`. |","table":"table-0"},"21":{"id":"/docs/architecture#19","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-zygisk-modules","content":"| Module               | id                 | Job                                                                             |\n| -------------------- | ------------------ | ------------------------------------------------------------------------------- |\n| PlayIntegrityFix 4.9 | `playintegrityfix` | Tries to satisfy Play Integrity. On an emulator: **NO_INTEGRITY**, permanently. |","table":"table-0"},"22":{"id":"/docs/architecture#20","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-zygisk-modules","content":"| Module                     | id               | Job                                                                                    |\n| -------------------------- | ---------------- | -------------------------------------------------------------------------------------- |\n| HMA-OSS (Vector-flavoured) | `hma_oss_zygisk` | Hides other installed packages from a target app (root/emulator detector enumeration). |","table":"table-0"},"23":{"id":"/docs/architecture#21","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-zygisk-modules","content":"| Module         | id           | Job                                                                                                                               |\n| -------------- | ------------ | --------------------------------------------------------------------------------------------------------------------------------- |\n| Cert-Fixer 1.1 | `cert-fixer` | Bind-mounts user CAs into `/apex/com.android.conscrypt/cacerts` at `post-fs-data`, so **GMS and Play Store** trust mitmproxy too. |","table":"table-0"},"24":{"id":"/docs/architecture#22","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-zygisk-modules","content":"| Module      | id     | Job                                                                             |\n| ----------- | ------ | ------------------------------------------------------------------------------- |\n| fsrv (ours) | `fsrv` | Renames and autostarts `frida-server` as `/data/adb/fsrv/hluda`, loopback only. |","table":"table-0"},"25":{"id":"/docs/architecture#23","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-zygisk-modules","content":"Zygisk Next's memory type is set to **anonymous** so module libs never appear in `/proc/<pid>/maps` as files."},"26":{"id":"/docs/architecture#24","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#4-interception","content":"<Mermaid chart=\"sequenceDiagram participant App participant Proxy as mitmdump :18080 participant Up as upstream App-…\" />"},"27":{"id":"/docs/architecture#25","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#4-interception","content":"Two details make this painless:"},"28":{"id":"/docs/architecture#26","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#4-interception","content":"**`adb reverse`** (device → host), not a proxy on the LAN, so no `http_proxy` is needed for pinned apps. `adb reverse` dies on every reboot; `nettap on` restores it."},"29":{"id":"/docs/architecture#27","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#4-interception","content":"**Cert-Fixer** mounts the CA at boot for the *whole system*, which is why Play Store and GMS traffic decrypts instead of failing with `does not trust the proxy's certificate`."},"30":{"id":"/docs/architecture#28","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#5-host-tooling","content":"`pentestctl` (health), `nettap` (proxy+tunnel+addon), `fspawn` (spawn under Frida with a profile), `fdp`/`cdp` (WebView DevTools), `session` (harvest cookies+storage), `replay` (re-issue requests), `recon` (static APK), `snap` (AVD snapshots), `uitap` (UI automation), `asu` (run root snippets)."},"31":{"id":"/docs/architecture#29","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#what-fails-if-you-remove-a-layer","content":"| Remove     | Symptom                                                                                         |\n| ---------- | ----------------------------------------------------------------------------------------------- |\n| Cert-Fixer | Chrome/WebView still decrypts (user CA), but **Play Store and GMS** throw TLS handshake errors. |","table":"table-1"},"32":{"id":"/docs/architecture#30","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#what-fails-if-you-remove-a-layer","content":"| Remove                         | Symptom                                                                             |\n| ------------------------------ | ----------------------------------------------------------------------------------- |\n| TrickyStore `target.txt` entry | App gets the emulator's fake AOSP chain → server rejects with an attestation error. |","table":"table-1"},"33":{"id":"/docs/architecture#31","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#what-fails-if-you-remove-a-layer","content":"| Remove       | Symptom                                                                                     |\n| ------------ | ------------------------------------------------------------------------------------------- |\n| Valid keybox | Chain becomes the bundled **software** AOSP keybox (expired intermediate) → server rejects. |","table":"table-1"},"34":{"id":"/docs/architecture#32","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#what-fails-if-you-remove-a-layer","content":"| Remove                         | Symptom                                               |\n| ------------------------------ | ----------------------------------------------------- |\n| `zygiskd enforce-denylist` off | Nothing breaks; denylist simply stops being honoured. |","table":"table-1"},"35":{"id":"/docs/architecture#33","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#what-fails-if-you-remove-a-layer","content":"| Remove        | Symptom                                                                                            |\n| ------------- | -------------------------------------------------------------------------------------------------- |\n| `adb reverse` | App talks to a dead proxy: spinner forever, zero flows. This is the #1 \"it broke overnight\" cause. |","table":"table-1"},"36":{"id":"/docs/architecture#34","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#what-fails-if-you-remove-a-layer","content":"| Remove      | Symptom                                                                    |\n| ----------- | -------------------------------------------------------------------------- |\n| Zygisk Next | No TrickyStore, no PIF, no HMA — attestation spoof and hiding both vanish. |","table":"table-1"},"37":{"id":"/docs/architecture#35","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#design-decisions-worth-knowing","content":"**Play Store image over AOSP** — closer to a real device for attestation checks; the cost is a heavier boot and GMS noise in every capture (filtered by `IGNORE` in `dump.py`)."},"38":{"id":"/docs/architecture#36","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#design-decisions-worth-knowing","content":"**Denylist policy `default`, not `whitelist`** — whitelist mode injects only for listed packages, but WebView renderer sandbox processes (`…:sandboxed_process0`, isolated uid) never match the package name, so every page load failed with `net_error -202`. Tried it, reverted it; see Root hiding."},"39":{"id":"/docs/architecture#37","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#design-decisions-worth-knowing","content":"**frida-server, not gadget** — gadget needs per-APK patching and re-signing, which changes the APK signature (and some servers check it). Server-side injection leaves the APK untouched."},"40":{"id":"/docs/architecture#38","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#design-decisions-worth-knowing","content":"**Loopback-only frida** — `LISTEN=127.0.0.1:27042` + `adb` forwarding. Nothing on the LAN can reach the agent, and no `frida-server` string appears in a listening-socket scan."},"41":{"id":"/docs/attestation","page_id":"/docs/attestation","type":"page","content":"Attestation & keyboxes","breadcrumbs":["Documentation","How it works"],"tags":[],"url":"/docs/attestation"},"42":{"id":"/docs/attestation#0","page_id":"/docs/attestation","type":"heading","tags":[],"url":"/docs/attestation#trickystore","content":"TrickyStore"},"43":{"id":"/docs/attestation#1","page_id":"/docs/attestation","type":"heading","tags":[],"url":"/docs/attestation#keybox-lifecycle","content":"Keybox lifecycle"},"44":{"id":"/docs/attestation#2","page_id":"/docs/attestation","type":"heading","tags":[],"url":"/docs/attestation#the-one-that-works-right-now","content":"The one that works right now"},"45":{"id":"/docs/attestation#3","page_id":"/docs/attestation","type":"heading","tags":[],"url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"Keeping it alive: `keybox-refresh`"},"46":{"id":"/docs/attestation#4","page_id":"/docs/attestation","type":"heading","tags":[],"url":"/docs/attestation#anatomy-of-a-rejected-keybox-real-example","content":"Anatomy of a rejected keybox (real example)"},"47":{"id":"/docs/attestation#5","page_id":"/docs/attestation","type":"heading","tags":[],"url":"/docs/attestation#what-the-server-actually-validates","content":"What the server actually validates"},"48":{"id":"/docs/attestation#6","page_id":"/docs/attestation","type":"heading","tags":[],"url":"/docs/attestation#verifying-on-device","content":"Verifying on-device"},"49":{"id":"/docs/attestation#7","page_id":"/docs/attestation","type":"heading","tags":[],"url":"/docs/attestation#play-integrity-is-a-different-problem","content":"Play Integrity is a different problem"},"50":{"id":"/docs/attestation#8","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation","content":"This is the part that usually makes people give up on emulator-based testing. A modern app asks the **Android keystore** to generate a key with a server-chosen challenge, and the keystore returns a certificate chain signed by Google's servers describing the device. The app ships that chain to its backend, which decides whether to let you in."},"51":{"id":"/docs/attestation#9","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation","content":"On an emulator that chain says *\"Droid Unregistered Device CA, Google Test LLC\"* — an obvious emulator. On a real phone it says *\"hardware-backed, verified boot green, your device\"*. Even with a software keybox the chain is signed by an **expired** AOSP intermediate. Both get rejected."},"52":{"id":"/docs/attestation#10","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation","content":"<Mermaid chart=\"sequenceDiagram participant App participant KS as Android Keystore participant TS as TrickyStore (Zy…\" />"},"53":{"id":"/docs/attestation#11","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#trickystore","content":"Module id `tricky_store`, manager UI in `com.example.target`-style apps is not needed — it is driven by two files."},"54":{"id":"/docs/attestation#12","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#trickystore","content":"`target.txt` — one package per line: **only these apps** get spoofed chains."},"55":{"id":"/docs/attestation#13","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#trickystore","content":"`keybox.xml` — the replacement chain material (EC and/or RSA), plus the private keys that let the keystore actually sign with it."},"56":{"id":"/docs/attestation#14","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#trickystore","content":"Reads `tee_status`; on an emulator `teeBroken=true` is expected."},"57":{"id":"/docs/attestation#15","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#trickystore","content":"The `DeviceID` attribute is just a label the upstream keybox author typed. For the public\n`RED-TEAM-KEYBOX` source it is literally a Telegram advert\n(`DeviceID=\"RKP keybox. Join my group: t.me/redteamchannell\"`). TrickyStore never uses it and the\nserver validates the **chain**, not the label — so it is normal for it to look like spam and to\nchange on every `keybox-refresh`. `pentestctl status` prints it tagged *(cosmetic upstream label)*."},"58":{"id":"/docs/attestation#16","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#trickystore","content":"Before adding the package, the app still receives the emulator's own fake chain. The server says *\"this device could not be verified\"* and you blame the keybox. Add the package, force-stop the app, relaunch — no reboot required."},"59":{"id":"/docs/attestation#17","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keybox-lifecycle","content":"A usable keybox must satisfy **all** of:"},"60":{"id":"/docs/attestation#18","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keybox-lifecycle","content":"Chain signatures verify up to a known root."},"61":{"id":"/docs/attestation#19","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keybox-lifecycle","content":"Nothing in the chain is **expired**."},"62":{"id":"/docs/attestation#20","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keybox-lifecycle","content":"The serial numbers are **not on Google's revocation list** (`https://android.googleapis.com/attestation/status`)."},"63":{"id":"/docs/attestation#21","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keybox-lifecycle","content":"It is a **hardware/RKP** chain — the server can tell software chains apart, and they are rejected by anything modern."},"64":{"id":"/docs/attestation#22","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keybox-lifecycle","content":"Check all four before installing:"},"65":{"id":"/docs/attestation#23","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keybox-lifecycle","content":"`root=None` is normal: the bundled root bundle (`tools/keybox-res/`) predates the RKP root (`CN=Key Attestation CA1`), so the root *pin* cannot be matched — signatures and revocation still validate, and the server is the real judge."},"66":{"id":"/docs/attestation#24","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#the-one-that-works-right-now","content":"Source: `redteam-git/RED-TEAM-KEYBOX` publishes a base64 blob at `…/main/conf` (refreshed every 4 h upstream). `setup-keybox.sh --file <xml>` installs a local file; `--check` validates only."},"67":{"id":"/docs/attestation#25","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"Keyboxes die quietly — the leaf expires and the server starts answering `4202` again with no other symptom. `keybox-refresh` is the boring fix:"},"68":{"id":"/docs/attestation#26","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"How it behaves:"},"69":{"id":"/docs/attestation#27","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"Reads the device keybox, runs `kbcheck.py --summary` (`device=… leaf_not_after=… sig=… revoked=…`)."},"70":{"id":"/docs/attestation#28","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"Stays put unless the keybox is close to expiry or already dead."},"71":{"id":"/docs/attestation#29","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"Tries sources in order — `redteam`, then `yuri` — accepting only payloads that `kbcheck.py --strict` accepts (signatures, chain, expiry, of the revocation list)."},"72":{"id":"/docs/attestation#30","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"Backs up the old keybox as `keybox.xml.bak_<ts>` and force-stops `com.example.target`, `com.android.vending`, `com.google.android.gms` so they re-open the keystore."},"73":{"id":"/docs/attestation#31","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"Appends to `~/.mobsec/keybox.log`."},"74":{"id":"/docs/attestation#32","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"It runs automatically through a **systemd user timer** (`mobsec-keybox.timer`: 10 min after boot, then daily with a randomised delay, `Persistent=true`):"},"75":{"id":"/docs/attestation#33","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#keeping-it-alive-keybox-refresh","content":"The current leaf expires **2026-12-04**; `pentestctl status` prints the remaining days on every run, so the timer is a safety net and not the primary signal."},"76":{"id":"/docs/attestation#34","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#anatomy-of-a-rejected-keybox-real-example","content":"The well-known Yurikey keybox had a perfect hardware chain — and its leaf serial `bb0d83fa2a47a1ae54c8c359778aaf35` was on Google's revocation list (2222 entries). Everything looked right in the UI, and the server still said no. Always check revocation, not just expiry."},"77":{"id":"/docs/attestation#35","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#what-the-server-actually-validates","content":"From the target app's behaviour, in order of strictness:"},"78":{"id":"/docs/attestation#36","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#what-the-server-actually-validates","content":"Chain parses and every signature verifies."},"79":{"id":"/docs/attestation#37","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#what-the-server-actually-validates","content":"Leaf public key matches the challenge-signed data."},"80":{"id":"/docs/attestation#38","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#what-the-server-actually-validates","content":"Chain contains Google's RKP attestation extension (hardware root of trust)."},"81":{"id":"/docs/attestation#39","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#what-the-server-actually-validates","content":"No serial is revoked, nothing expired."},"82":{"id":"/docs/attestation#40","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#what-the-server-actually-validates","content":"Sometimes: `verifiedBootState` = green, `deviceLocked` = true, `osVersion` sane."},"83":{"id":"/docs/attestation#41","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#what-the-server-actually-validates","content":"TrickyStore supplies 1–5 for keystore users, but the **revocation list** is checked server-side and cannot be spoofed locally. That is why a revoked keybox is worthless even though the UI shows a beautiful chain."},"84":{"id":"/docs/attestation#42","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#verifying-on-device","content":"Install **KeyAttestation** (`io.github.vvb2060.keyattestation`, in `apks/`) and generate a key:"},"85":{"id":"/docs/attestation#43","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#verifying-on-device","content":"✅ expected: `CN=App Attest Key` issued by `O=TEE,CN=<32 hex>`, \"Bootloader is locked\", manufacturer from the keybox, ~32 certs issued in the last 30 days."},"86":{"id":"/docs/attestation#44","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#verifying-on-device","content":"⚠️ expected on this rig: banner *\"Unknown root certificate — root is not a known trusted CA\"*. Its local root pool does not contain the RKP root; the target server's does. Not a failure."},"87":{"id":"/docs/attestation#45","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#verifying-on-device","content":"❌ if you see `CN=Android Keystore Software Attestation Intermediate`: `target.txt` is missing the package, or `keybox.xml` is the bundled software one."},"88":{"id":"/docs/attestation#46","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#play-integrity-is-a-different-problem","content":"Play Integrity's `MEETS_DEVICE_INTEGRITY` cannot be faked on an emulator; measured here as **UNEVALUATED** (Google declines to grade an emulator with no account) before and after PlayIntegrityFix. This rig does not solve PI, and does not need to for apps that use raw key attestation. The mechanics, the `integrity` tool and the escape routes are on the Play Integrity page."},"89":{"id":"/docs/attestation#47","page_id":"/docs/attestation","tags":[],"type":"text","url":"/docs/attestation#play-integrity-is-a-different-problem","content":"`PlayIntegrityFork` v19 ships only arm64/armv7 `zygisk` libs, so on this x86_64 image it silently never loads (`zygiskd status` stops listing `playintegrityfix`). The installed module is `PlayIntegrityFix_v4.9-inject-s.zip`, which does ship x86_64. v19 is parked in `modules/archive/`."},"90":{"id":"/docs/checklist","page_id":"/docs/checklist","type":"page","content":"Pentest checklist (mapped to this rig)","breadcrumbs":["Documentation","Method"],"tags":[],"url":"/docs/checklist"},"91":{"id":"/docs/checklist#0","page_id":"/docs/checklist","type":"heading","tags":[],"url":"/docs/checklist#1-before-you-install-anything-static","content":"1. Before you install anything (static)"},"92":{"id":"/docs/checklist#1","page_id":"/docs/checklist","type":"heading","tags":[],"url":"/docs/checklist#2-install-and-get-it-running","content":"2. Install and get it running"},"93":{"id":"/docs/checklist#2","page_id":"/docs/checklist","type":"heading","tags":[],"url":"/docs/checklist#3-runtime-storage","content":"3. Runtime: storage"},"94":{"id":"/docs/checklist#3","page_id":"/docs/checklist","type":"heading","tags":[],"url":"/docs/checklist#4-runtime-network","content":"4. Runtime: network"},"95":{"id":"/docs/checklist#4","page_id":"/docs/checklist","type":"heading","tags":[],"url":"/docs/checklist#5-runtime-webview--hybrid-apps","content":"5. Runtime: WebView / hybrid apps"},"96":{"id":"/docs/checklist#5","page_id":"/docs/checklist","type":"heading","tags":[],"url":"/docs/checklist#6-runtime-components-and-injection","content":"6. Runtime: components and injection"},"97":{"id":"/docs/checklist#6","page_id":"/docs/checklist","type":"heading","tags":[],"url":"/docs/checklist#7-server-side-where-the-money-usually-is","content":"7. Server side (where the money usually is)"},"98":{"id":"/docs/checklist#7","page_id":"/docs/checklist","type":"heading","tags":[],"url":"/docs/checklist#8-what-this-rig-cannot-tell-you","content":"8. What this rig cannot tell you"},"99":{"id":"/docs/checklist#8","page_id":"/docs/checklist","type":"heading","tags":[],"url":"/docs/checklist#reporting-habit","content":"Reporting habit"},"100":{"id":"/docs/checklist#9","page_id":"/docs/checklist","tags":[],"type":"text","url":"/docs/checklist","content":"This is the HackTricks/OWASP-MASTG Android checklist, rewritten as *\"which command in this rig does that, and where does it stop working\"*. Use it so you do not reinvent steps — and so you do not claim coverage the emulator cannot give you."},"101":{"id":"/docs/checklist#10","page_id":"/docs/checklist","tags":[],"type":"text","url":"/docs/checklist","content":"Legend: **✔** a command does it · **~** partial, read the note · **✘** impossible or pointless here."},"102":{"id":"/docs/checklist#11","page_id":"/docs/checklist","tags":[],"type":"text","url":"/docs/checklist#1-before-you-install-anything-static","content":"| Check                                 | Command         |     |\n| ------------------------------------- | --------------- | --- |\n| What is it, who signed it, which SDKs | `recon app.apk` | ✔   |","table":"table-0"},"103":{"id":"/docs/checklist#12","page_id":"/docs/checklist","tags":[],"type":"text","url":"/docs/checklist#1-before-you-install-anything-static","content":"| Check                                | Command                             |     |\n| ------------------------------------ | ----------------------------------- | --- |\n| Obfuscation / packer / anti-VM hints | `recon` → Packers section (`apkid`) | ✔   |","table":"table-0"},"104":{"id":"/docs/checklist#13","page_id":"/docs/checklist","tags":[],"type":"text","url":"/docs/checklist#1-before-you-install-anything-static","content":"| Check                                 | Command                                                                    |     |\n| ------------------------------------- | -------------------------------------------------------------------------- | --- |\n| `APKiD` says `anti_vm` / `anti_debug` | verify by hand in jadx — it fires on Google/Firebase/Material library code | ~   |","table":"table-0"},"105":{"id":"/docs/checklist#14","page_id":"/docs/checklist","tags":[],"type":"text","url":"/docs/checklist#1-before-you-install-anything-static","content":"| Check                                         | Command                                 |   